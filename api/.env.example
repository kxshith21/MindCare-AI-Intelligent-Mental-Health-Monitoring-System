# Copy to .env and fill in values. NEVER commit real secrets.

ENVIRONMENT=development

# Supabase project (Postgres + Auth). The API verifies JWTs against this project's JWKS.
SUPABASE_URL=https://your-project.supabase.co
# Optional override; defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Service role key (server-side only) — powers POST /auth/psychologist-signup.
# NEVER expose this in web/ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000

# LLM service layer (Phase 3) — provider-agnostic, env-configured.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
