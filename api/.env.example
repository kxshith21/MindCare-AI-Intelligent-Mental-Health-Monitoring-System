# Copy to .env and fill in values. NEVER commit real secrets.

ENVIRONMENT=development

# Server-only kill switch: set false to pause AI chat without redeploying.
CHAT_ENABLED=true

# Supabase project (Postgres + Auth). The API verifies JWTs against this project's JWKS.
SUPABASE_URL=https://your-project.supabase.co
# Optional override; defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Service role key (server-side only) — powers server-side signup, assistant
# message writes, risk-event inserts and account deletion.
# NEVER expose this in web/ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000

# LLM service layer (Phase 3).
# "openai" = OpenAI-compatible /chat/completions. With the base URL below this
# is GROQ, so LLM_API_KEY must be a GROQ API key — NOT an OpenAI key.
# Use LLM_PROVIDER=fake only for offline tests (no network calls).
LLM_PROVIDER=openai
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
CHAT_PROMPT_VERSION=chat_system_v1
