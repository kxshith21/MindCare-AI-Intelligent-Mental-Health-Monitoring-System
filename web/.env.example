# Copy to .env.local and fill in values. NEVER commit real secrets.

# Supabase project (Postgres + Auth) — wired up in Phase 2.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MindCare API (FastAPI) base URL. Server-only: the browser calls /api/* and
# this Next.js route handler forwards the user's bearer token to FastAPI.
# NEXT_PUBLIC_API_URL is accepted as a local-development fallback only.
API_URL=http://localhost:8000
